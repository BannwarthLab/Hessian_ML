Bootstrap: docker
From: ubuntu:22.04

%environment
    # Add the virtual environment to PATH
    export PATH="/opt/venv/bin:$PATH"
    export CC=gcc
    export FC=gfortran

%post
    # Update and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        git \
        python3.11 \
        python3.11-venv \
        python3.11-dev \
        python3-pip \
        gfortran \
        build-essential \
        libopenblas-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

    # Upgrade pip, setuptools, wheel
    python3.11 -m pip install --upgrade pip setuptools wheel

    # Create a Python virtual environment
    python3.11 -m venv /opt/venv

    # Install tblite from source linking to gfortran
    /opt/venv/bin/pip install --no-binary=tblite --no-cache-dir tblite
    /opt/venv/bin/pip install git+https://gitlab+deploy-token-1478:${PRIVATE_DEPLOY_TOKEN}@git.rwth-aachen.de/bannwarthlab/tcgm-lib-py.git
    /opt/venv/bin/pip install .[dev] ruff mypy codespell pytest pytest-cov types-requests types-PyYAML

%test
    # Test that tblite loads correctly
    python3.11 -c "import tblite.interface; print('tblite C extension loaded successfully')"