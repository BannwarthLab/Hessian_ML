Bootstrap: docker
From: ubuntu:24.04

%environment
    # Add the virtual environment to PATH
    export CC=gcc
    export FC=gfortran
    export PATH=/opt/venv/bin:$PATH
    export OPENBLAS_CORETYPE=NEHALEM
    #export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/openblas-pthread:$LD_LIBRARY_PATH

%post
    # Update and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        git \
        python3 \
        python3-venv \
        python3-dev \
        python3-pip \
        gfortran \
        build-essential \
        libopenblas-dev \
        libgfortran5 \
        libquadmath0 \
        libc6 \
        libgcc-s1 \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

    #install venv
    python3 -m venv /opt/venv
    # Activate it
    . /opt/venv/bin/activate
    # Upgrade pip, setuptools, wheel

    pip install --upgrade pip setuptools wheel

    # Install tblite from source linking to gfortran
    export CFLAGS="-O2 -march=x86-64 -mtune=generic"
    export FFLAGS="-O2 -march=x86-64 -mtune=generic"
    export OPENBLAS_CORETYPE=NEHALEM
    pip install --no-binary=tblite --no-cache-dir tblite
    ldd /opt/venv/lib/python3.12/site-packages/tblite/_libtblite*.so
    
%test
    # Test that tblite loads correctly
    . /opt/venv/bin/activate
    python3 -c "import tblite.interface; print('tblite C extension loaded successfully')"

