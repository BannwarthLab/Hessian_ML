Bootstrap: docker
From: ubuntu:22.04

%environment
    # Add the virtual environment to PATH
    export PATH="/opt/venv/bin:$PATH"
    export CC=gcc
    export FC=gfortran

%post
    # Update and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        git \
        python3.11 \
        python3.11-venv \
        python3.11-dev \
        python3-pip \
        gfortran \
        build-essential \
        libopenblas-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

    # Upgrade pip, setuptools, wheel
    python3.11 -m pip install --upgrade pip setuptools wheel
    # Install tblite from source linking to gfortran
    python3.11 -m pip install --no-binary=tblite --no-cache-dir tblite
    

%test
    # Test that tblite loads correctly
    python3.11 -c "import tblite.interface; print('tblite C extension loaded successfully')"