Bootstrap: docker
From: ubuntu:24.04

%environment
    # Add the virtual environment to PATH
    export CC=gcc
    export FC=gfortran
    export PATH="~/.local/venv/bin:$PATH"
    export OPENBLAS_CORETYPE=NEHALEM

%post
    # Update and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        git \
        python3 \
        python3-venv \
        python3-dev \
        python3-pip \
        gfortran \
        build-essential \
        libopenblas-dev \
        libgfortran5 \
        libquadmath0 \
        libc6 \
        libgcc-s1 \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

    #install venv
    python3 -m venv ~/.local/venv
    # Activate it
    . ~/.local/venv/bin/activate
    # Upgrade pip, setuptools, wheel
    pip install --upgrade pip setuptools wheel
    # Install tblite from source linking to gfortran
    export CFLAGS="-O2 -march=x86-64 -mtune=generic"
    export FFLAGS="-O2 -march=x86-64 -mtune=generic"
    export OPENBLAS_CORETYPE=NEHALEM
    pip install --no-binary=tblite --no-cache-dir tblite
    
%test
    # Test that tblite loads correctly
    . ~/.local/venv/bin/activate
    python3 -c "import tblite.interface; print('tblite C extension loaded successfully')"